formulas:
  updated_days: "(now() - file.mtime).days"
properties:
  file.name:
    displayName: Note
  status:
    displayName: Status
  type:
    displayName: Type
  formula.updated_days:
    displayName: "Updated (d ago)"
views:
  - type: table
    name: Projects
    filters:
      and:
        - file.inFolder("projects")
        - 'file.ext == "md"'
    order:
      - file.name
      - status
      - formula.updated_days
      - tags
  - type: table
    name: Teams & Process
    filters:
      and:
        - file.inFolder("meta")
        - 'file.ext == "md"'
    order:
      - file.name
      - formula.updated_days
  - type: table
    name: Recently Updated
    limit: 30
    filters:
      and:
        - 'file.ext == "md"'
    order:
      - file.name
      - file.folder
      - formula.updated_days
